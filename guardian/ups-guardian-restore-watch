#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="/var/lib/ups-guardian"
POWERFAIL_MARKER="$STATE_DIR/powerfail_active"

# A power failure ignored while disarmed: once the window closes, act on it if
# the UPS is still on battery, otherwise just forget it.
SUPPRESSED="$STATE_DIR/onbatt_suppressed"
if [[ -f "$SUPPRESSED" && ! -f "$POWERFAIL_MARKER" ]]; then
    until="$(cat "$STATE_DIR/disarmed_until" 2>/dev/null || echo 0)"
    [[ "$until" =~ ^[0-9]+$ ]] || until=0
    if (( until <= $(date +%s) )); then
        if pwrstat -status 2>/dev/null | grep -qi "Power Supply by.*Utility Power"; then
            rm -f "$SUPPRESSED"
        else
            logger -t ups-guardian "Disarm window ended while on battery; running onbatt"
            /usr/local/sbin/ups-guardian onbatt
        fi
    fi
fi

# Low-battery backstop. pwrstatd fires lowbatt once per crossing and
# ups-guardian declines one that was only a shed-load dip, so while an outage
# is being handled keep checking against the same thresholds.
if [[ -f "$POWERFAIL_MARKER" || -f "$SUPPRESSED" ]] && ! pgrep -f "ups-guardian lowbatt" >/dev/null; then
    if [[ "$(/usr/local/sbin/ups-guardian battery)" == low* ]]; then
        logger -t ups-guardian "Watcher: battery is below the low line; running lowbatt"
        /usr/local/sbin/ups-guardian lowbatt
    fi
fi

# deadlock_shutdown_success outlives the marker when deadlock's power-on
# failed, so keep ticking until it is back.
if [[ ! -f "$POWERFAIL_MARKER" && ! -f "$STATE_DIR/deadlock_shutdown_success" ]]; then
    exit 0
fi

if pwrstat -status 2>/dev/null | grep -qi "Power Supply by.*Utility Power"; then
    /usr/local/sbin/ups-guardian online
fi
